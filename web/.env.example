# NASA FIRMS MAP_KEY (https://firms.modaps.eosdis.nasa.gov/api/map_key/). Server-side only.
FIRMS_MAP_KEY=
# FIRMS source & day range used by /api/firms
FIRMS_SOURCE=VIIRS_SNPP_NRT
FIRMS_DAYS=1
# Optional raster tile basemap streamed onto the globe (God Eye style). {z}/{x}/{y} template.
# Example: https://basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}.png
NEXT_PUBLIC_BASEMAP_TILE_URL=
