# ── NASA data ─────────────────────────────────────────────────────────────────
# NASA FIRMS MAP_KEY (https://firms.modaps.eosdis.nasa.gov/api/map_key/). Server-side only.
FIRMS_MAP_KEY=
FIRMS_SOURCE=VIIRS_SNPP_NRT
FIRMS_DAYS=1

# ── Real-world 3D map (God Eye map stack) ─────────────────────────────────────
# Route selection mirrors gods-eye-view/src/maps/google3d.js:
#   Google key  → Google Photorealistic 3D Tiles (direct, Map Tiles API)
#   ion token   → the same Google tiles via Cesium ion asset 2275207
#   neither     → keyless: Re:Earth quantized-mesh terrain + Esri World Imagery
# Both keys are CLIENT-EXPOSED by design — restrict them by HTTP referrer / API scope.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_CESIUM_ION_TOKEN=
# Optional: override the ion asset (default 2275207 = Google Photorealistic 3D Tiles)
# NEXT_PUBLIC_CESIUM_ION_ASSET_ID=2275207
# Set to 1 to disable all 3D tiles (vector basemap globe + procedural tactical terrain)
# NEXT_PUBLIC_DISABLE_3D_TILES=

# Raster basemap used only when 3D tiles are disabled ({z}/{x}/{y} template; default NASA GIBS Blue Marble)
# NEXT_PUBLIC_BASEMAP_TILE_URL=
